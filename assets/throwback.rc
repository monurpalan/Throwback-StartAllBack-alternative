// The original Windows images, one script so their icons get distinct IDs.
// CMake defines THROWBACK_ASSETS_<FOLDER> for each folder that is present.
#include "ui/skin_ids.h"

// Throwback's own icon, the first one in the file, so Explorer shows it for
// the exe. Built from the four eras' logos by tools/make-logo.py.
1 ICON "app/throwback.ico"

#ifdef THROWBACK_ASSETS_WIN7
#include "win7.rc"
#endif
#ifdef THROWBACK_ASSETS_CLASSIC
#include "classic.rc"
#endif
#ifdef THROWBACK_ASSETS_XP
#include "xp.rc"
#endif
#ifdef THROWBACK_ASSETS_VISTA
#include "vista.rc"
#endif
#ifdef THROWBACK_ASSETS_WIN8
#include "win8.rc"
#endif
#ifdef THROWBACK_ASSETS_MODERN
#include "modern.rc"
#endif
#ifdef THROWBACK_ASSETS_ORBS
#include "orbs.rc"
#endif
#ifdef THROWBACK_ASSETS_PLAIN8
#include "plain8.rc"
#endif
